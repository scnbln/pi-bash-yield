{
  "name": "pi-bash-yield",
  "version": "0.1.0",
  "description": "Pi extension: a running foreground bash command steps aside when you send a message, keeps running as a background job, and reports back when it finishes.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "bash",
    "steering",
    "background-jobs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scnbln/pi-bash-yield.git"
  },
  "homepage": "https://github.com/scnbln/pi-bash-yield#readme",
  "bugs": {
    "url": "https://github.com/scnbln/pi-bash-yield/issues"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "test:e2e": "node --test 'test/e2e/*.test.mjs'",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
